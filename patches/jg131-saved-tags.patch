+              decrements.allSatisfy({ $0.value <= (tags[$0.key]?.count ?? 0) }) else { throw LocalSavedTagsError.corruptStore }
+        var removed: Int32 = 0
+        for message in affected { removed += try eraseRelations(message, tags: &tags) }
