+                } else { label = "… · \(tag.count)" }
+            }
+            let title = (self.selectedTag == tag.id ? "▸ " : "") + tag.name
+            add("tag:\(tag.id)", 1, .action, title, value: label, action: self.mutating ? nil : .tag(tag.id))
+        }
+        if let tagId = self.selectedTag {
+            let name = self.tags.first(where: { $0.id == tagId })?.name ?? ""
+            add("filter", 2, .text, strings.text("Local filter: \(name)", "Локальный фильтр: \(name)"))
+            add("clear", 2, .action, strings.text("Clear local filter", "Сбросить локальный фильтр"), action: self.mutating ? nil : .clear)
+            add("query", 2, .text, strings.query)
+            add("bounds", 2, .text, strings.text("45 messages per page; up to 135 visible. Use Older / Newer to reach every tagged message. No automatic prefetch.", "45 сообщений на страницу; до 135 видимых. Кнопки «Старее» / «Новее» позволяют дойти до всех сообщений с тегом. Нет автоматической предзагрузки."))
+            if self.loading { add("loadingPage", 2, .text, strings.text("Loading messages…", "Загрузка сообщений…")) }
+            if let content = self.content {
+                add("newer", 2, .action, strings.text("Newer", "Новее"), action: !self.loading && content.later != nil ? .later : nil)
+                let rows = content.windows.flatMap { $0 }.sorted { lhs, rhs in
+                    if lhs.entry.timestamp != rhs.entry.timestamp { return lhs.entry.timestamp > rhs.entry.timestamp }
+                    return lhs.entry.id > rhs.entry.id
+                }
+                if rows.isEmpty { add("emptyFilter", 3, .text, strings.text("No messages with this local tag.", "Нет сообщений с этим локальным тегом.")) }
+                if rows.contains(where: { $0.message == nil }) {
+                    add("unavailableInfo", 3, .text, strings.text("Unavailable content keeps its saved ID and date. Tap the row to retry, open Saved Messages, or remove this local tag.", "Недоступный контент сохраняет ID и дату в Избранном. Нажмите строку для повторной загрузки, перехода в Избранное или удаления этого локального тега."))
+                }
+                for row in rows {
+                    let id = String(describing: row.entry.id)
+                    if let message = row.message {
+                        add("message:\(id)", 3, .message, "", message: message)
+                    } else {
+                        // Different stable identity: ItemList must never update a
+                        // text/disclosure node as a ChatListItemNode after retry.
+                        let stamp = DateFormatter.localizedString(from: Date(timeIntervalSince1970: Double(row.entry.timestamp)), dateStyle: .short, timeStyle: .short)
+                        add("unavailable:\(id)", 3, .action, strings.text("Unavailable message #\(row.entry.id.id)", "Недоступное сообщение №\(row.entry.id.id)"), value: stamp, action: .unavailable(row.entry.id))
+                    }
+                }
+                add("older", 4, .action, strings.text("Older", "Старее"), action: !self.loading && content.earlier != nil ? .earlier : nil)
+            }
+        }
+        return (ItemListControllerState(presentationData: ItemListPresentationData(presentation), title: .text(strings.title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentation.strings.Common_Back)),
+            (ItemListNodeState(presentationData: ItemListPresentationData(presentation), entries: entries, style: .blocks, animateChanges: false), self))
+    }
+}
+
+private final class JerkgramSavedTagsController: ItemListController {
+    private let session: JerkgramSavedTagsSession
+    init(context: AccountContext, selectedIds: [MessageId]) {
+        let session = JerkgramSavedTagsSession(context: context, selectedIds: selectedIds)
+        self.session = session
+        let presentation = context.sharedContext.currentPresentationData.with { $0 }
+        let state = combineLatest(context.sharedContext.presentationData, session.changes.get())
+        |> deliverOnMainQueue
+        |> map { [session] presentation, _ in session.render(presentation) }
+        super.init(presentationData: ItemListPresentationData(presentation), updatedPresentationData: context.sharedContext.presentationData |> map { ItemListPresentationData($0) }, state: state, tabBarItem: nil)
+        session.controller = self
+    }
+    required init(coder: NSCoder) { preconditionFailure() }
+    override func viewDidAppear(_ animated: Bool) { super.viewDidAppear(animated); self.session.start() }
+    override func viewWillDisappear(_ animated: Bool) { self.session.stop(); super.viewWillDisappear(animated) }
+    deinit { self.session.stop() }
+}
+
+func jerkgramSavedTagsController(context: AccountContext, selectedMessageIds: [MessageId] = []) -> ViewController {
+    return JerkgramSavedTagsController(context: context, selectedIds: selectedMessageIds)
+}
