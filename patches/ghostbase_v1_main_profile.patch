+
+private func gbBool(_ key: String, _ defaultValue: Bool = true) -> Bool {
+    if UserDefaults.standard.object(forKey: key) == nil {
+        return defaultValue
+    }
+    return UserDefaults.standard.bool(forKey: key)
+}
+
+private func gbSetBool(_ key: String, _ value: Bool, synchronize: Bool = true) {
+    UserDefaults.standard.set(value, forKey: key)
+    if synchronize {
+        _ = UserDefaults.standard.synchronize()
+    }
+}
+
+private func gbSetBools(_ keys: [String], _ value: Bool) {
+    for key in keys {
+        gbSetBool(key, value, synchronize: false)
+    }
+    _ = UserDefaults.standard.synchronize()
+}
