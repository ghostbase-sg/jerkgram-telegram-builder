+    }
+    func lifecycle(_ kind: BotBridgeDiagnosticLifecycle) {
+        lock.lock(); let scope = self.scope; lock.unlock()
+        scope?.lifecycle(kind, terminal: false)
+    }
+    func context(flags: BotBridgeOperationFlags) -> BotBridgeOperationContext? {
+        lock.lock(); let scope = self.scope; lock.unlock()
