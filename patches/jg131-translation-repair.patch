+// Foundation-only recognition sample: keep offsets stable for overlapping entities.
+private func jerkgramTranslationRecognitionSample(_ text: String, maskedRanges: [Range<Int>]) -> String {
+    let sample = String(text.prefix(256))
+    let utf16 = sample as NSString
+    let count = utf16.length
+    func isBoundary(_ offset: Int) -> Bool {
+        if offset == 0 || offset == count { return true }
+        // Validate code units explicitly; Foundation accepts some ranges that
+        // divide a surrogate pair. Combining-mark scalar boundaries stay valid.
+        return !((0xD800 ... 0xDBFF).contains(utf16.character(at: offset - 1)) && (0xDC00 ... 0xDFFF).contains(utf16.character(at: offset)))
+    }
+    let masked = NSMutableString(string: sample)
+    for range in maskedRanges {
+        let end = min(range.upperBound, count)
+        guard range.lowerBound >= 0, range.lowerBound < end,
+              isBoundary(range.lowerBound), isBoundary(end) else { continue }
+        masked.replaceCharacters(in: NSRange(location: range.lowerBound, length: end - range.lowerBound), with: String(repeating: " ", count: end - range.lowerBound))
+    }
+    return masked as String
+}
 
