+private func jerkgramTranslateLocalMessages(account: Account, messages: [Message], toLang: String) -> Signal<Void, TranslationError> {
+    guard let service = engineExperimentalInternalTranslationService else { return .fail(.generic) }
+    guard messages.count <= 64 else { return .fail(.textTooLong) }
+    let signals: [Signal<Bool, NoError>] = messages.map { original in
+        guard let texts = jerkgramLocalMessageTexts(original), !texts.isEmpty,
+              texts.count <= 16, texts.allSatisfy({ !$0.isEmpty }) else { return .single(false) }
+        var mapped: [AnyHashable: String] = [:]
+        let keys = texts.indices.map { AnyHashable("jg-local:\(account.peerId.toInt64()):\(original.id.peerId.toInt64()):\(original.id.namespace):\(original.id.id):\($0)") }
+        for (index, key) in keys.enumerated() { mapped[key] = texts[index] }
+        // Empty source requests local per-message recognition, not chat-majority language.
+        let cancelled = Atomic(value: false)
+        return service.translate(texts: mapped, fromLang: "", toLang: toLang)
+        |> mapToSignal { result -> Signal<Bool, NoError> in
+            guard let result, keys.allSatisfy({ result[$0]?.isEmpty == false }) else { return .single(false) }
+            let translated = keys.map { result[$0]! }
+            return account.postbox.transaction { transaction -> Bool in
+                guard !cancelled.with({ $0 }) else { return false }
+                var stored = false
+                transaction.updateMessage(original.id, update: { current in
+                    // Compare and store atomically. Late edit/delete/recovery results cannot win.
+                    guard jerkgramTranslationSourceMatches(original, current) else { return .skip }
+                    stored = true
+                    var additional: [TranslationMessageAttribute.Additional] = []
+                    var solution: TranslationMessageAttribute.Additional?
+                    if let poll = original.media.first(where: { $0 is TelegramMediaPoll }) as? TelegramMediaPoll {
+                        for index in poll.options.indices { additional.append(.init(text: translated[index + 1], entities: [])) }
+                        if poll.results.solution != nil { solution = .init(text: translated[translated.count - 1], entities: []) }
+                    }
+                    var attributes = current.attributes.filter { !($0 is TranslationMessageAttribute) }
+                    attributes.append(TranslationMessageAttribute(text: translated[0], entities: [], additional: additional, pollSolution: solution, toLang: toLang, jerkgramSourceFingerprint: jerkgramTranslationSourceFingerprint(original)))
+                    return .update(StoreMessage(id: current.id, customStableId: nil, globallyUniqueId: current.globallyUniqueId, groupingKey: current.groupingKey, threadId: current.threadId, timestamp: current.timestamp, flags: StoreMessageFlags(current.flags), tags: current.tags, globalTags: current.globalTags, localTags: current.localTags, forwardInfo: current.forwardInfo.flatMap(StoreMessageForwardInfo.init), authorId: current.author?.id, text: current.text, attributes: attributes, media: current.media))
+                })
+                return stored
+            }
+        }
+        |> afterDisposed { _ = cancelled.swap(true) }
+    }
+    if signals.isEmpty { return .single(Void()) }
+    return combineLatest(signals)
+    |> castError(TranslationError.self)
+    |> mapToSignal { outcomes -> Signal<Void, TranslationError> in
+        // Finish independent successes first; one unavailable item cannot cancel others.
+        outcomes.allSatisfy({ $0 }) ? .single(Void()) : .fail(.generic)
+    }
+}
