+public func ghostBaseSettingsController(
+    context: AccountContext
+) -> ViewController {
+    let rawPage = UserDefaults.standard.string(
+        forKey: "jerkgram.Settings.InitialPage"
+    ) ?? "home"
+
+    UserDefaults.standard.removeObject(
+        forKey: "jerkgram.Settings.InitialPage"
+    )
+
+    let page: GhostBaseSettingsPage
+
+    switch rawPage {
+    case "ghostMode":
+        page = .ghostMode
+    case "messages":
+        page = .messages
+    case "protectedContent":
+        page = .protectedContent
+    case "mediaStories":
+        page = .mediaStories
+    case "appearance":
+        page = .appearance
+    case "debugResearch":
+        page = .debugResearch
+    case "about":
+        page = .about
+    default:
+        page = .home
+    }
+
+    return ghostBaseSettingsPageController(
+        context: context,
+        page: page
+    )
+}
