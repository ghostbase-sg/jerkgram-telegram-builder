+
+private func ghostBaseHiddenGiftCheckText(
+    _ result: CanSendGiftResult
+) -> String {
+    switch result {
+    case .available:
+        return "available"
+    case let .unavailable(text, _):
+        return text.isEmpty
+            ? "unavailable"
+            : "unavailable: \(text)"
+    case .failed:
+        return "failed"
+    }
+}
