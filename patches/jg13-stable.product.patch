+    var nanos: Int32 = 0
+    if parts.count > 1 {
+        var fraction = String(parts[1])
+        if fraction.count > 9 {
+            fraction = String(fraction.prefix(9))
+        }
+        while fraction.count < 9 {
+            fraction.append("0")
+        }
+        nanos = Int32(fraction) ?? 0
+    }
+
+    return StarsAmount(value: whole, nanos: nanos)
+}
