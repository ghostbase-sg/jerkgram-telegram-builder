+private func ghostBaseIsValidStarsAmountInput(_ text: String) -> Bool {
+    var hasSeparator = false
+
+    for (index, ch) in text.enumerated() {
+        if ch == "-" || ch == "+" {
+            if index != 0 {
+                return false
+            }
+        } else if ch >= "0" && ch <= "9" {
+            continue
+        } else if ch == "," || ch == "." {
+            if hasSeparator {
+                return false
+            }
+            hasSeparator = true
+        } else if ch == " " || ch == "\u{00a0}" {
+            continue
+        } else {
+            return false
+        }
+    }
+
+    return true
+}
