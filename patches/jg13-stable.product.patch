+                options: [.backwards]
+            ),
+            plistStart.lowerBound
+                < plistEnd.upperBound
+        else {
+            continue
+        }
+
+        let plistText = String(
+            profileText[
+                plistStart.lowerBound
+                ..< plistEnd.upperBound
+            ]
+        )
+
