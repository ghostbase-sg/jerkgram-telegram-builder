+private enum JerkgramAppearanceAction: Equatable {
+    case master, emoji, chooseEmoji, duration, clearEmoji, profile, background, name, reply, preview, reset
+}
+
+private struct JerkgramAppearanceEntry: ItemListNodeEntry {
+    let stableId: Int
+    let section: ItemListSectionId
+    let title: String
+    let label: String
+    let value: Bool?
+    let action: JerkgramAppearanceAction?
+    static func <(lhs: Self, rhs: Self) -> Bool { lhs.stableId < rhs.stableId }
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! JerkgramAppearanceArguments
+        if let value, let action {
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, sectionId: section, style: .blocks, updated: { [weak arguments] value in arguments?.perform(action, value: value) })
+        } else if let action {
+            return ItemListDisclosureItem(presentationData: presentationData, title: title, label: label, sectionId: section, style: .blocks, action: { [weak arguments] in arguments?.perform(action) })
+        } else {
+            return ItemListTextItem(presentationData: presentationData, text: .plain(title), sectionId: section)
+        }
+    }
+}
+
+private final class JerkgramAppearanceArguments {
+    let context: AccountContext
+    weak var controller: ItemListController?
+    init(context: AccountContext) { self.context = context }
+    func text(_ english: String, _ russian: String) -> String {
+        context.sharedContext.currentPresentationData.with { $0.strings.jerkgram.languageCode.hasPrefix("ru") } ? russian : english
+    }
+    func perform(_ action: JerkgramAppearanceAction, value: Bool? = nil) {
+        let store = context.jerkgramLocalAppearance
+        guard controller != nil, store.snapshot.eligible else { return }
+        switch action {
+        case .master:
+            store.update { $0.enabled = value ?? false }
+        case .emoji:
+            if value == true && store.snapshot.settings.emojiFileId == nil { perform(.chooseEmoji); return }
+            store.update { $0.emojiEnabled = value ?? false }
+        case .chooseEmoji:
+            guard let controller, store.snapshot.settings.enabled else { return }
+            let generation = store.snapshot.activityGeneration
+            let selected = store.snapshot.settings.emojiFileId
+            var selectedItems = Set<AnyHashable>()
+            if let selected { selectedItems.insert(EngineMedia.Id(namespace: Namespaces.Media.CloudFile, id: selected)) }
+            let picker = EmojiStatusSelectionController(context: context, mode: .customStatusSelection(completion: { [weak self] file, expiration in
+                guard let self, self.controller != nil else { return }
+                self.context.jerkgramLocalAppearance.update(expectedGeneration: generation) {
+                    $0.emojiFileId = file?.fileId.id; $0.emojiExpiration = expiration
+                    $0.emojiEnabled = file != nil
+                }
+            }), sourceView: controller.navigationBar?.view ?? controller.view,
+            emojiContent: EmojiPagerContentComponent.emojiInputData(context: context, animationCache: context.animationCache, animationRenderer: context.animationRenderer, isStandalone: false, subject: .status, hasTrending: false, topReactionItems: [], areUnicodeEmojiEnabled: false, areCustomEmojiEnabled: true, chatPeerId: context.account.peerId, selectedItems: selectedItems, topStatusTitle: nil, forceHasPremium: true), currentSelection: selected, localAppearance: true, destinationItemView: { nil })
+            controller.present(picker, in: .window(.root))
+        case .duration:
+            guard let controller, store.snapshot.settings.enabled, store.snapshot.settings.emojiFileId != nil else { return }
+            let presentation = context.sharedContext.currentPresentationData.with { $0 }
+            let generation = store.snapshot.activityGeneration
+            let sheet = ActionSheetController(presentationData: presentation)
+            var items: [ActionSheetItem] = []
+            for (title, seconds) in [(text("Permanent", "Постоянно"), Int32(0)), (text("1 hour", "1 час"), 3600), (text("8 hours", "8 часов"), 28800), (text("1 day", "1 день"), 86400)] {
+                items.append(ActionSheetButtonItem(title: title, color: .accent, action: { [weak self, weak sheet] in
+                    sheet?.dismissAnimated()
+                    guard let self, self.controller != nil else { return }
+                    self.context.jerkgramLocalAppearance.update(expectedGeneration: generation) { settings in
+                        settings.emojiExpiration = seconds == 0 ? nil : Int32(clamping: Int64(Date().timeIntervalSince1970) + Int64(seconds))
+                    }
+                }))
+            }
+            sheet.setItemGroups([ActionSheetItemGroup(items: items), ActionSheetItemGroup(items: [ActionSheetButtonItem(title: presentation.strings.Common_Cancel, color: .accent, action: { [weak sheet] in sheet?.dismissAnimated() })])])
+            controller.present(sheet, in: .window(.root))
+        case .clearEmoji:
+            store.update { $0.emojiEnabled = false; $0.emojiFileId = nil; $0.emojiExpiration = nil }
+        case .profile, .background, .name, .reply, .preview:
+            guard store.snapshot.settings.enabled else { return }
+            let tag: UserAppearanceEntryTag
+            switch action {
+            case .name: tag = .name
+            case .reply: tag = .nameAddIcons
+            case .background: tag = .profileAddIcons
+            default: tag = .profile
+            }
+            controller?.push(UserAppearanceScreen(context: context, focusOnItemTag: tag, localAppearance: true))
+        case .reset:
+            store.update { settings in settings = JerkgramLocalAppearanceSettings(owner: settings.owner, peer: settings.peer, testing: settings.testing) }
+        }
+    }
+}
