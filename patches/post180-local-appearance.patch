+            if snapshot.settings.enabled {
+                add(1, text("Local Emoji Status", "Локальный Emoji Status"), value: snapshot.settings.emojiEnabled, action: .emoji)
+                add(1, text("Choose emoji", "Выбор эмодзи"), label: snapshot.settings.emojiFileId == nil ? text("None", "Нет") : text("Selected", "Выбрано"), action: .chooseEmoji)
+                let duration = snapshot.settings.emojiExpiration.map { DateFormatter.localizedString(from: Date(timeIntervalSince1970: Double($0)), dateStyle: .short, timeStyle: .short) } ?? text("Permanent", "Постоянно")
+                add(1, text("Duration", "Срок действия"), label: duration, action: snapshot.settings.emojiFileId == nil ? nil : .duration)
+                if snapshot.settings.emojiFileId != nil { add(1, text("Remove local status", "Убрать локальный статус"), action: .clearEmoji) }
+                add(2, text("Profile color", "Цвет профиля"), action: .profile)
+                add(2, text("Profile background emoji", "Фоновый эмодзи профиля"), action: .background)
+                add(2, text("Name color", "Цвет имени"), action: .name)
+                add(2, text("Reply appearance", "Оформление ответов"), action: .reply)
+                add(2, text("Native preview", "Предпросмотр"), action: .preview)
+            }
+            add(3, text("Restore standard appearance", "Восстановить стандартное оформление"), action: .reset)
+            add(3, text("Stored in this account's local database. No cloud sync; not included in Jerkgram backups. Removing the account or reinstalling can lose these choices.", "Хранится в локальной базе этого аккаунта. Нет синхронизации с облаком; не входит в бэкапы Jerkgram. При удалении аккаунта или переустановке настройки могут быть потеряны."))
+        } else {
+            add(0, text("Available only for your active personal account. Bot accounts cannot use local profile appearance.", "Доступно только для активного личного аккаунта. Локальное оформление для ботов отключено."))
+        }
+        return (ItemListControllerState(presentationData: ItemListPresentationData(presentation), title: .text(text("Profile Appearance", "Оформление профиля")), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentation.strings.Common_Back)), (ItemListNodeState(presentationData: ItemListPresentationData(presentation), entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(presentationData: ItemListPresentationData(initial), updatedPresentationData: context.sharedContext.presentationData |> map { ItemListPresentationData($0) }, state: signal, tabBarItem: nil)
