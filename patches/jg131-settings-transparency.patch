+    func settingsBackdropImage(isDark: Bool) -> UIImage? {
+        guard self.usesCustomBackground, !self.bounds.isEmpty else { return nil }
+        let source = self.imageView.image
+        let aspect = self.bounds.height / self.bounds.width
+        if let cached = self.settingsSnapshot, self.settingsSnapshotSource === source,
+           self.settingsSnapshotState == self.currentStateKey, self.settingsSnapshotDark == isDark,
+           abs(self.settingsSnapshotAspect - aspect) < 0.001 { return cached }
+        let size = CGSize(width: 192.0, height: min(512.0, max(192.0, 192.0 * aspect)))
+        let format = UIGraphicsImageRendererFormat()
+        format.scale = 1.0
+        format.opaque = true
+        let pixels = UIGraphicsImageRenderer(size: size, format: format).image { context in
+            (self.backgroundColor ?? (isDark ? UIColor.black : UIColor.white)).setFill()
+            context.fill(CGRect(origin: .zero, size: size))
+            if let source, source.size.width > 0.0, source.size.height > 0.0 {
+                let factor = max(size.width / source.size.width, size.height / source.size.height)
+                let target = CGSize(width: source.size.width * factor, height: source.size.height * factor)
+                source.draw(in: CGRect(x: (size.width - target.width) / 2.0, y: (size.height - target.height) / 2.0, width: target.width, height: target.height))
+            }
+        }
+        guard let cgImage = pixels.cgImage else { return nil }
+        let input = CIImage(cgImage: cgImage)
+        let blurred = input.clampedToExtent().applyingFilter("CIGaussianBlur", parameters: [kCIInputRadiusKey: 12.0]).cropped(to: input.extent)
+        guard let output = Self.settingsCIContext.createCGImage(blurred, from: input.extent) else { return nil }
+        let result = UIGraphicsImageRenderer(size: size, format: format).image { context in
+            UIImage(cgImage: output).draw(in: CGRect(origin: .zero, size: size))
+            (isDark ? UIColor.black : UIColor.white).withAlphaComponent(isDark ? 0.52 : 0.58).setFill()
+            context.fill(CGRect(origin: .zero, size: size))
+        }
+        self.settingsSnapshotSource = source
+        self.settingsSnapshotState = self.currentStateKey
+        self.settingsSnapshotDark = isDark
+        self.settingsSnapshotAspect = aspect
+        self.settingsSnapshot = result
+        return result
+    }
